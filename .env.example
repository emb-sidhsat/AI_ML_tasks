# NHTSA Early Warning System — environment variable reference
# Copy to .env and fill in values. .env is gitignored and never committed.
#
# Usage:
#   cp .env.example .env          # create your local copy
#   docker compose --env-file .env up pipeline

# ── Pipeline control ────────────────────────────────────────────────────────
# Which phase to run: 'all' or a single digit 1-5
PHASE=all

# Skip SBERT + BART-MNLI (avoids ~2 GB model downloads; Layers 1 & 2 only)
SKIP_SEMANTIC=false

# Force re-fetch from NHTSA API even if cached CSVs exist in data/raw/
FORCE_REFETCH=false

# ── NHTSA API ───────────────────────────────────────────────────────────────
# Public API — no key required. Override base URL only to point at a mock server.
NHTSA_BASE=https://api.nhtsa.gov

# Polite delay between requests (seconds). Set to 0 in local dev/CI only.
API_DELAY=0.5

# SSL certificate verification. Set to false ONLY if behind a corporate proxy with
# self-signed certificates (e.g. Zscaler). NOT recommended for untrusted networks.
NHTSA_API_VERIFY_SSL=false

# ── HuggingFace ─────────────────────────────────────────────────────────────
# Optional. Models used (all-MiniLM-L6-v2, facebook/bart-large-mnli) are public
# so HF_TOKEN is not required for downloads. Set it to:
#   - Avoid anonymous download rate limits (~16 GB/hr without token)
#   - Access private or gated models in future
# Generate at: https://huggingface.co/settings/tokens  (read-only scope is enough)
HF_TOKEN=

# ── Docker build — corporate network ────────────────────────────────────────
# In environments where pypi.org / download.pytorch.org are behind an SSL-inspection
# proxy (e.g. Zscaler), pip cert verification fails inside docker build.
# Point pip at the internal Artifactory mirror and mark its host as trusted:
# PIP_INDEX_URL=https://jfrog.devstack.vwgroup.com/artifactory/api/pypi/pypi/simple/
# PIP_TRUSTED_HOST=jfrog.devstack.vwgroup.com
# These are passed as Docker build-args; leave empty for standard internet builds.
PIP_INDEX_URL=
PIP_TRUSTED_HOST=

# ── Azure Blob Storage (future — not yet wired) ─────────────────────────────
# Uncomment and set when the Blob cache layer is added (Step 2 of Azure plan).
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_BLOB_CONTAINER=nhtsa-cache
