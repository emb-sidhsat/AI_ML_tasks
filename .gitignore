# Data files — never commit raw API pulls or large processed files
data/raw/*.csv
data/raw/*.json
data/processed/*.csv
data/processed/*.npy
data/processed/*.pkl
data/outputs/*.png
data/outputs/*.csv

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/outputs/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg
.Python

# Virtual environments
venv/
env/
.venv/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Model weights (large — use HuggingFace hub directly)
*.safetensors
*.bin
models/

# Secrets
.env
*.key
