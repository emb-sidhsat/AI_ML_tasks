# Version control
.git/
.gitignore

# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/

# Virtual environment — dependencies are installed inside the image
.venv/
venv/
env/

# Data lake — mounted at runtime; never bake generated datasets into the image
data/bronze/
data/silver/
data/gold/

# Archive notebooks are large and not needed inside the container
docs/archive/notebooks/

# Model weights — pulled from HuggingFace at runtime
*.safetensors
*.bin
models/

# Secrets and local config
.env
*.key

# IDE and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
